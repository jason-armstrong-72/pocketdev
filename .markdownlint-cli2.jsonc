{
  // Glob + ignore config for markdownlint-cli2 (rules live in .markdownlint.jsonc)
  "globs": ["**/*.md"],

  // Every ignore that can nest is anchored with `**/`. An un-anchored
  // "node_modules/**" matches only the tree at the repo root, so a nested
  // package's dependencies would get linted.
  "ignores": ["**/node_modules/**", "**/.next/**", "**/dist/**", "**/build/**"]
}
